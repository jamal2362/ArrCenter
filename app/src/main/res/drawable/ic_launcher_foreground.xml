<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a play button in the centre with four connected services
    around it - the app is a hub for several self-hosted services.

    All artwork stays within a radius of 33 around the centre (54,54). The adaptive icon
    safe zone is the inner 72dp circle of the 108dp canvas, so nothing is clipped by a
    round, squircle or squared launcher mask.

    Pure white fill and no android:tint, so the same drawable also serves as the monochrome
    layer, where the system applies its own tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hub: ring with the play triangle knocked out via even-odd. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M40,54a14,14 0 1,0 28,0a14,14 0 1,0 -28,0zM49.5,46.5L49.5,61.5L62,54z" />

    <!-- Connectors between the hub and the four services. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,41L54,33M67,54L75,54M54,67L54,75M41,54L33,54" />

    <!-- The four services. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,27a6,6 0 1,0 12,0a6,6 0 1,0 -12,0z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M75,54a6,6 0 1,0 12,0a6,6 0 1,0 -12,0z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,81a6,6 0 1,0 12,0a6,6 0 1,0 -12,0z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M21,54a6,6 0 1,0 12,0a6,6 0 1,0 -12,0z" />

</vector>
