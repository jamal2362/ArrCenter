<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a radar sweep with a contact - Radarr and Sonarr are named
    after radar and sonar, so the motif points at the service family the app collects.

    All artwork stays within a radius of 33 around the centre (54,54). The adaptive icon
    safe zone is the inner 72dp circle of the 108dp canvas, so nothing is clipped by a
    round, squircle or squared launcher mask.

    Pure white and no android:tint, so the same drawable also serves as the monochrome
    layer, where the system applies its own tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer range ring. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:pathData="M24,54a30,30 0 1,0 60,0a30,30 0 1,0 -60,0z" />

    <!-- Inner range ring. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:pathData="M37,54a17,17 0 1,0 34,0a17,17 0 1,0 -34,0z" />

    <!-- Sweep line. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M54,54L75,33" />

    <!-- Contact. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M35.5,68a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0z" />

</vector>
