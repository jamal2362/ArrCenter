<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Local Network Protection (Android 17+): without this runtime permission every
        request to a LAN address is blocked and the WebView reports
        net::ERR_LOCAL_NETWORK_PERMISSION_MISSING. Self-hosted services live on the local
        network, so the app is unusable without it.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <queries>
        <package android:name="com.google.android.youtube" />

        <!-- Needed to hand non-http links (mailto:, magnet:, …) to a suitable app. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>

        <!--
            Custom Tabs: without these two the app cannot see any browser, so
            CustomTabsClient.getPackageName() returns null and every external link would
            leave the app instead of opening the in-app browser.
        -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ArrCenter"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|layoutDirection">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
